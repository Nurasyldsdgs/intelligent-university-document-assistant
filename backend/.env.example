# Copy this file to backend/.env and put your real key there. Do not commit .env.
# Format is KEY=VALUE without quotes. Real environment variables override these values.

# Your API key (gsk_... for Groq, sk-... for OpenAI). OPENAI_API_KEY=... works as well.
AI_API_KEY=gsk-your-key-here

# Groq (default):
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# OpenAI:
#AI_BASE_URL=https://api.openai.com/v1
#AI_MODEL=gpt-4o-mini

# DeepSeek:
#AI_BASE_URL=https://api.deepseek.com/v1
#AI_MODEL=deepseek-chat

# OpenRouter:
#AI_BASE_URL=https://openrouter.ai/api/v1
#AI_MODEL=openai/gpt-4o-mini

# --- Secrets read by application.yml (see application.example.yml) ---
# Database (the default matches docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/doc_assistant_db
DB_USERNAME=postgres
DB_PASSWORD=postgres_password

# JWT signing key, Base64, at least 256 bits: openssl rand -base64 32
# Leave commented for local dev (a dev-only default applies); always set it in production.
#JWT_SECRET=replace-with-output-of-openssl-rand-base64-32

# Gmail SMTP for OTP emails (Google App Password, spaces removed); MAIL_FROM must equal MAIL_USERNAME
MAIL_USERNAME=your-account@example.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM=your-account@example.com

# Google OAuth2 login
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- AI throughput (optional; defaults shown) ---
# Parallel background AI jobs; keep low on Groq's free tier to avoid 429 rate limits
#AI_MAX_CONCURRENCY=2
# Tries per AI call on 429/5xx, the first one included
#AI_MAX_ATTEMPTS=3
# Deadlines the AI finds start as drafts for the teacher to publish; true = publish at once (Sprint 2 behavior)
#AI_AUTO_PUBLISH_ASSIGNMENTS=false

# --- File storage (optional; default is a local folder) ---
#STORAGE_DRIVER=s3
#S3_BUCKET=unidocs-uploads
#S3_REGION=eu-central-1
# MinIO only:
#S3_ENDPOINT=http://localhost:9000
#S3_PATH_STYLE_ACCESS=true
# S3 credentials do NOT go in this file: Spring reads backend/.env, the AWS SDK does not. Set AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY as real environment variables, or use ~/.aws/credentials, or an instance/container role.

# --- Security (optional) ---
# true only behind a reverse proxy that sets X-Forwarded-For (login rate limits use the client IP)
#TRUST_FORWARDED_FOR=false

# --- Personal data (optional) ---
# Masking of IIN, phones, e-mails and ID numbers before texts reach the AI, search and Q&A; true by default.
#PRIVACY_ENABLED=true
# Comma-separated domains whose e-mails are not personal (stay readable), e.g. the university's own.
#PRIVACY_PUBLIC_EMAIL_DOMAINS=sdu.edu.kz

# --- OCR for scanned PDFs and images (optional) ---
# Needs Tesseract with the rus, kaz and eng language packs. Off by default.
#OCR_ENABLED=true
# Folder of tesseract(.exe) or the executable itself; empty = found on PATH
#OCR_TESSERACT_PATH=C:/Program Files/Tesseract-OCR
#OCR_LANGUAGES=rus+kaz+eng
#OCR_TIMEOUT=120s
#OCR_MAX_PAGES=20
