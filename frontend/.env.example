# Frontend settings (Vite). Copy to .env.local and adjust; every variable is optional.

# Backend origin. Default: http://localhost:8080
# VITE_BACKEND_URL=http://localhost:8080

# IANA time zone for dates that carry a zone (e.g. Asia/Almaty). Default: the browser's zone.
# Dates the backend sends without a zone are already in the server's local time and are shown unchanged.
# VITE_APP_TIME_ZONE=Asia/Almaty
